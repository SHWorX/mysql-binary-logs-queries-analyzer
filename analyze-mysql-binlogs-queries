"""Analyze MySQL/MariaDB binary logs and report operation counts per table.

How it works
------------
1. Select the binary logs that can contain events in the requested time window.
2. Run ``mysqlbinlog`` once per log file (in parallel) and *stream* its output,
   counting INSERT / UPDATE / DELETE / TRUNCATE / DROP operations per table in
   a single pass. Nothing decoded is ever written to disk.
3. Merge the per-file counters and write a report plus a list of analyzed logs.
4. Optionally (--write-queries) also collect sample SQL queries per operation and table
   and write them to one file per operation type.
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from collections import Counter
from concurrent.futures import ProcessPoolExecutor, as_completed
from dataclasses import dataclass
from datetime import datetime, timedelta
from pathlib import Path
from typing import Dict, List, Optional, Sequence, Tuple

# ========  CONSTANTS  ========
SCRIPT_VERSION = "1.0.0"
ALL_OPERATIONS = ('update', 'insert', 'delete', 'truncate', 'drop')
DEFAULT_LOG_DIR = Path('/var/lib/mysql')
DEFAULT_LOG_NAME = 'mysql-bin'
DATETIME_FORMAT = '%Y-%m-%d %H:%M:%S'

# Row-based events (mysqlbinlog -v), example: "### INSERT INTO `db`.`tbl`"
ROW_RE = re.compile(r'^### (INSERT INTO|UPDATE|DELETE FROM) (\S+)')
ROW_OPERATIONS = {'INSERT INTO': 'insert', 'UPDATE': 'update', 'DELETE FROM': 'delete'}

# Statement-based events (binlog_format=STATEMENT/MIXED) and DDL.
_NAME = r'([`\w.$]+)'
STATEMENT_RES = {
    'insert': re.compile(rf'^INSERT\s+(?:(?:LOW_PRIORITY|DELAYED|HIGH_PRIORITY|IGNORE)\s+)*INTO\s+{_NAME}', re.I),
    'update': re.compile(rf'^UPDATE\s+(?:(?:LOW_PRIORITY|IGNORE)\s+)*{_NAME}', re.I),
    'delete': re.compile(rf'^DELETE\s+(?:(?:LOW_PRIORITY|QUICK|IGNORE)\s+)*FROM\s+{_NAME}', re.I),
    'truncate': re.compile(rf'^TRUNCATE\s+(?:TABLE\s+)?{_NAME}', re.I),
    'drop': re.compile(rf'^DROP\s+(?:TEMPORARY\s+)?(?:TABLE|DATABASE|SCHEMA|VIEW|INDEX)\s+(?:IF\s+EXISTS\s+)?{_NAME}', re.I),
}
# mysqlbinlog stderr lines that are expected and harmless (the requested window simply extends beyond the end of a file).
BENIGN_STDERR_RE = re.compile(r"^WARNING: Did not reach stop datetime\b")

# Cheap pre-filter: Every keyword above starts with one of these characters.
STATEMENT_FIRST_CHARS = frozenset('IUDTiudt')
# In "### ..." lines only the row header lines (INSERT INTO / UPDATE / DELETE FROM) have  one of these at index 4;
# "### WHERE", "### SET" and "###   @1=..." lines do not.
ROW_FIRST_CHARS = frozenset('IUD')

# Statements in mysqlbinlog output are terminated by this delimiter.
STATEMENT_END = '/*!*/;'

# Event header line, e.g. #241206 12:09:28 server id 1  end_log_pos 123 CRC32 0x0b7a9f85  Update_rows: ...
EVENT_RE = re.compile(
    r'^#(\d{6})\s+(\d{1,2}:\d{2}:\d{2})\s+server id \d+\s+end_log_pos \d+'
    r'(?:\s+CRC32 0x[0-9a-fA-F]+)?\s+(\w+)')
ROW_EVENT_PREFIXES = ('Table_map', 'Write_rows', 'Update_rows', 'Delete_rows')


# ========  OUTPUT  ========
class Printer:
    """Prints formatted messages. Colors are only used when stdout is a TTY
    (and NO_COLOR is not set), so redirected output stays free of escape codes."""

    RESET = '\033[0m'
    BOLD = '\033[1m'
    COLORS = {
        'error': '\033[91m',
        'warning': '\033[93m',
        'success': '\033[92m',
        'tool': '\033[36m',
        'default': '',
    }
    color_enabled = sys.stdout.isatty() and 'NO_COLOR' not in os.environ

    @classmethod
    def _emit(cls, kind, msg, bold=False, prefix=None, end='\n', stream=None):
        stream = stream or sys.stdout
        use_color = cls.color_enabled and stream.isatty()
        color = cls.COLORS[kind]
        if use_color and (color or bold):
            style = (cls.BOLD if bold else '') + color
            msg = f'{style}{msg}{cls.RESET}'
        if prefix:
            tag = f'{cls.BOLD}{color}{prefix}{cls.RESET}' if use_color else prefix
            msg = f'{tag} {msg}'
        print(msg, end=end, file=stream, flush=True)

    @classmethod
    def error(cls, msg, **kw):
        cls._emit('error', msg, prefix='ERROR:', stream=sys.stderr, **kw)

    @classmethod
    def warning(cls, msg, **kw):
        cls._emit('warning', msg, prefix='WARNING:', stream=sys.stderr, **kw)

    @classmethod
    def success(cls, msg, **kw):
        cls._emit('success', msg, **kw)

    @classmethod
    def tool(cls, msg, **kw):
        cls._emit('tool', msg, **kw)

    @classmethod
    def default(cls, msg, **kw):
        cls._emit('default', msg, **kw)


class BinlogAnalysisError(Exception):
    """Raised when mysqlbinlog fails for a file."""


# ========  CONFIGURATION  ========
@dataclass(frozen=True)
class Config:
    dt_from: datetime
    dt_to: datetime
    log_dir: Path
    log_name: str
    output_dir: Path
    operations: Tuple[str, ...]
    skip_gtid_strict_mode: bool
    jobs: int
    mysqlbinlog: str
    ignore_mtime: bool
    write_queries: bool = False
    query_samples: int = 1


def parse_datetime(value: str, end_of_day: bool = False) -> datetime:
    """Parse 'YYYY-MM-DD', 'YYYY-MM-DD HH:MM:SS' or a 10-digit Unix timestamp.

    A bare date becomes 00:00:00, or 23:59:59 when *end_of_day* is True.
    """
    value = value.strip()
    if re.fullmatch(r'\d{10}', value):
        return datetime.fromtimestamp(int(value))
    try:
        day = datetime.strptime(value, '%Y-%m-%d')
        return day.replace(hour=23, minute=59, second=59) if end_of_day else day
    except ValueError:
        pass
    try:
        return datetime.strptime(value, DATETIME_FORMAT)
    except ValueError:
        raise argparse.ArgumentTypeError(
            f'invalid datetime "{value}" (use YYYY-MM-DD, "YYYY-MM-DD HH:MM:SS" or a Unix timestamp)')


def parse_datetime_end(value: str) -> datetime:
    return parse_datetime(value, end_of_day=True)


def parse_operations(value: str) -> Tuple[str, ...]:
    """Normalize a comma separated operation list (case-insensitive)."""
    requested = {item.strip().lower() for item in value.split(',') if item.strip()}
    if not requested or 'all' in requested:
        return ALL_OPERATIONS
    unknown = requested - set(ALL_OPERATIONS)
    if unknown:
        raise argparse.ArgumentTypeError(
            f'unknown SQL operation(s): {", ".join(sorted(unknown))} '
            f'(allowed: all, {", ".join(ALL_OPERATIONS)})')
    return tuple(op for op in ALL_OPERATIONS if op in requested)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog='analyze-mysql-binlogs-queries',
        description='Count INSERT/UPDATE/DELETE/TRUNCATE/DROP operations per table in MySQL/MariaDB binary logs.')
    parser.add_argument(
        '-f', '--dt-from',
        type=parse_datetime,
        metavar='DATETIME',
        help='Start of the analyzed period (YYYY-MM-DD, "YYYY-MM-DD HH:MM:SS" or Unix timestamp). '
             'A bare date means 00:00:00. Default: today 00:00:00.')
    parser.add_argument(
        '-t', '--dt-to',
        type=parse_datetime_end,
        metavar='DATETIME',
        help='End of the analyzed period, inclusive (same formats). A bare date means 23:59:59. '
             'Default: today 23:59:59.')
    parser.add_argument(
        '-n', '--binary-logs-file-name',
        default=DEFAULT_LOG_NAME,
        metavar='NAME',
        help=f'Binary log base name without the numeric extension (default: {DEFAULT_LOG_NAME}).')
    parser.add_argument(
        '-p', '--binary-logs-file-path',
        type=Path,
        default=DEFAULT_LOG_DIR,
        metavar='PATH',
        help=f'Directory containing the binary logs (default: {DEFAULT_LOG_DIR}).')
    parser.add_argument(
        '-o', '--output-path',
        type=Path,
        default=None,
        metavar='PATH',
        help='Directory for the report files (default: current directory).')
    parser.add_argument(
        '-s', '--sql-operations',
        type=parse_operations,
        default=ALL_OPERATIONS,
        metavar='OPS',
        help='Comma separated operations to report: all, update, insert, delete, truncate, drop '
             '(default: all). Example: --sql-operations=update,insert')
    parser.add_argument(
        '-g', '--no-skip-gtid-strict-mode',
        action='store_true',
        help='Never pass --skip-gtid-strict-mode to mysqlbinlog. By default it is passed only if '
             'a MariaDB mysqlbinlog is detected (MySQL does not support it).')
    parser.add_argument(
        '-j', '--jobs',
        type=int,
        default=min(4, os.cpu_count() or 1),
        metavar='N',
        help='Number of mysqlbinlog processes to run in parallel (default: min(4, CPU count)).')
    parser.add_argument(
        '--mysqlbinlog',
        default='mysqlbinlog',
        metavar='BIN',
        help='Name or path of the mysqlbinlog executable (default: mysqlbinlog).')
    parser.add_argument(
        '--ignore-mtime',
        action='store_true',
        help='Do not pre-select log files by modification time; rely only on mysqlbinlog\'s event '
             'timestamps. Use this if the logs were copied/restored and their mtimes are unreliable.')
    parser.add_argument(
        '-q', '--write-queries',
        action='store_true',
        help='Additionally write one file per operation type (<ts>_binary-logs-<op>-queries.sql) '
             'containing the full SQL of sample queries found in the logs. Note: SELECT statements '
             'are never written to binary logs, so they can not appear.')
    parser.add_argument(
        '--query-samples',
        type=int,
        default=1,
        metavar='N',
        help='With --write-queries: how many example queries to keep per operation and table '
             '(default: 1). Use 0 to write ALL queries (can produce very large files).')
    parser.add_argument(
        '--no-color',
        action='store_true',
        help='Disable colored output.')
    parser.add_argument(
        '-v', '--version',
        action='version',
        version=f'%(prog)s {SCRIPT_VERSION}',
        help='Show the script version and exit.'
    )
    return parser


def build_config(args: argparse.Namespace, parser: argparse.ArgumentParser) -> Config:
    """Validate the parsed arguments and return the final working configuration."""
    today = datetime.now().replace(hour=0, minute=0, second=0, microsecond=0)
    dt_from = args.dt_from or today
    dt_to = args.dt_to or today.replace(hour=23, minute=59, second=59)
    if dt_from > dt_to:
        parser.error(f'the start datetime ({dt_from:{DATETIME_FORMAT}}) must not be later than '
                     f'the end datetime ({dt_to:{DATETIME_FORMAT}})')

    if args.jobs < 1:
        parser.error('--jobs must be at least 1')

    log_dir = args.binary_logs_file_path.expanduser().resolve()
    if log_dir == Path(log_dir.anchor):
        parser.error(f'the binary logs path "{log_dir}" can\'t be the filesystem root')
    if not log_dir.is_dir() or not os.access(log_dir, os.R_OK | os.X_OK):
        parser.error(f'the binary logs path "{log_dir}" does not exist or is not readable')

    output_dir = (args.output_path or Path.cwd()).expanduser().resolve()
    if output_dir == Path(output_dir.anchor):
        parser.error(f'the output path "{output_dir}" can\'t be the filesystem root')
    if not output_dir.is_dir() or not os.access(output_dir, os.W_OK | os.X_OK):
        parser.error(f'the output path "{output_dir}" does not exist or is not writable')

    mysqlbinlog = shutil.which(args.mysqlbinlog)
    if mysqlbinlog is None:
        parser.error(f'"{args.mysqlbinlog}" was not found. Install the MySQL/MariaDB client tools '
                     f'or pass --mysqlbinlog=/path/to/mysqlbinlog')

    if args.query_samples < 0:
        parser.error('--query-samples must be 0 (all) or a positive number')

    skip_gtid = False if args.no_skip_gtid_strict_mode else is_mariadb(mysqlbinlog)

    return Config(
        dt_from=dt_from, dt_to=dt_to, log_dir=log_dir, log_name=args.binary_logs_file_name,
        output_dir=output_dir, operations=args.sql_operations, skip_gtid_strict_mode=skip_gtid,
        jobs=args.jobs, mysqlbinlog=mysqlbinlog, ignore_mtime=args.ignore_mtime,
        write_queries=args.write_queries, query_samples=args.query_samples)


def is_mariadb(mysqlbinlog: str) -> bool:
    """True if the given mysqlbinlog is the MariaDB flavor (the only one that
    knows --skip-gtid-strict-mode)."""
    try:
        result = subprocess.run([mysqlbinlog, '--version'], capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.SubprocessError):
        return False
    return 'mariadb' in (result.stdout + result.stderr).lower()


def print_config(cfg: Config) -> None:
    Printer.tool('MySQL Binary Logs Analyzer v' + SCRIPT_VERSION)
    Printer.default('+---------------------------------------------------+\n'
                    '|  F I N A L   W O R K I N G   P A R A M E T E R S  |\n'
                    '+---------------------------------------------------+')
    Printer.default(
        f'Datetime from:                {cfg.dt_from:{DATETIME_FORMAT}}\n'
        f'Datetime to (inclusive):      {cfg.dt_to:{DATETIME_FORMAT}}\n'
        f'Binary logs path:             {cfg.log_dir}\n'
        f'Binary logs name:             {cfg.log_name}.<number>\n'
        f'Output path:                  {cfg.output_dir}\n'
        f'SQL operations:               {",".join(cfg.operations)}\n'
        f'Skip GTID strict mode:        {cfg.skip_gtid_strict_mode}\n'
        f'Parallel jobs:                {cfg.jobs}\n'
        f'mysqlbinlog:                  {cfg.mysqlbinlog}\n'
        f'Filter files by mtime:        {not cfg.ignore_mtime}\n'
        f'Write sample queries:         '
        f'{("yes (" + (str(cfg.query_samples) if cfg.query_samples else "all") + " per table)") if cfg.write_queries else "no"}')
    Printer.default('=====================================================')


# ========  LOG DISCOVERY  ========
def find_binlogs(cfg: Config) -> List[str]:
    """Return the binary logs that can contain events inside the time window,
    sorted by their numeric extension.

    A bin log's mtime is the time of its *last* write, so:
      * a file whose mtime is before the window start cannot contain relevant events;
      * the first file whose mtime is at/after the window end may still hold events
        from inside the window (it started before the end), but every file after it
        started later than that and can be skipped.
    Exact filtering by event time is done by mysqlbinlog itself.
    """
    regex = re.compile(rf'^{re.escape(cfg.log_name)}\.(\d+)$')
    candidates = []
    with os.scandir(cfg.log_dir) as entries:
        for entry in entries:
            match = regex.match(entry.name)
            if match and entry.is_file():
                mtime = datetime.fromtimestamp(entry.stat().st_mtime)
                candidates.append((int(match.group(1)), entry.path, mtime))
    candidates.sort()

    if cfg.ignore_mtime:
        return [path for _, path, _ in candidates]

    selected = []
    for _, path, mtime in candidates:
        if mtime < cfg.dt_from:
            continue
        selected.append(path)
        if mtime >= cfg.dt_to:
            break
    return selected


# ========  ANALYSIS  ========
def build_base_command(cfg: Config) -> List[str]:
    """mysqlbinlog command without the file argument. --stop-datetime is
    exclusive in mysqlbinlog, so one second is added to make dt_to inclusive."""
    command = [
        cfg.mysqlbinlog, '--base64-output=decode-rows', '-v',
        f'--start-datetime={cfg.dt_from:{DATETIME_FORMAT}}',
        f'--stop-datetime={cfg.dt_to + timedelta(seconds=1):{DATETIME_FORMAT}}',
    ]
    if cfg.skip_gtid_strict_mode:
        command.append('--skip-gtid-strict-mode')
    return command


def _clean_name(name: str) -> str:
    return name.replace('`', '')


def _clean_statement(lines: Sequence[str]) -> str:
    """Turn the captured statement lines into plain SQL ending with ';'."""
    text = ''.join(lines).rstrip()
    if text.endswith(STATEMENT_END):
        text = text[:-len(STATEMENT_END)].rstrip()
    return text if text.endswith(';') else text + ';'


class _SampleWriter:
    """Collects the sampled queries of ONE binlog in a JSON-lines temp file (one entry
    per line), so memory use stays bounded however many queries are captured."""

    def __init__(self, path: str, binlog_name: str, limit: int):
        self.path = path
        self.binlog_name = binlog_name
        self.limit = limit
        self.taken: Counter = Counter()
        self.handle = None

    def wants(self, op: str, table: str) -> bool:
        return self.limit == 0 or self.taken[(op, table)] < self.limit

    def add(self, op: str, table: str, ts: str, pos: str, body: str, kind: str,
            original: Optional[str] = None) -> None:
        lines = [f'-- {ts or "?"} | {self.binlog_name} @ {pos or "?"} | {table}']
        if original:
            lines.append('-- Original statement (Rows_query event):')
            lines.append(original if original.endswith(';') else original + ';')
        if kind == 'row':
            lines.append('-- Row image as decoded by mysqlbinlog (@N = N-th column of the table):')
            lines.append(body.rstrip('\n'))
        else:
            lines.append(body)
        if self.handle is None:
            self.handle = open(self.path, 'w', encoding='utf-8')
        self.handle.write(json.dumps({'op': op, 'table': table, 'entry': '\n'.join(lines)}) + '\n')
        self.taken[(op, table)] += 1

    def close(self) -> None:
        if self.handle is not None:
            self.handle.close()
            self.handle = None


def analyze_file(base_command: Sequence[str], binlog: str, operations: Sequence[str],
                 samples_path: Optional[str] = None,
                 samples_per_table: int = 1) -> Tuple[str, Dict[str, Counter]]:
    """Run mysqlbinlog on one file and count operations per table while streaming
    its stdout. If *samples_path* is given, the full SQL of up to *samples_per_table*
    queries per operation and table (0 = all) is also written there.

    Runs in a worker process, so it only takes/returns picklable data."""
    wanted = set(operations)
    counts = {op: Counter() for op in operations}
    sampler = _SampleWriter(samples_path, Path(binlog).name, samples_per_table) if samples_path else None

    last_at = ''
    event_ts = ''
    event_pos = ''
    rows_query: Optional[List[str]] = None
    collecting_rows_query = False
    row_lines: Optional[List[str]] = None
    row_meta = None
    stmt_lines: Optional[List[str]] = None
    stmt_meta = None

    def finish_row() -> None:
        nonlocal row_lines, row_meta
        if row_lines is not None:
            op, table, ts, pos, original = row_meta
            sampler.add(op, table, ts, pos, ''.join(row_lines), 'row', original)
        row_lines = row_meta = None

    def finish_stmt() -> None:
        nonlocal stmt_lines, stmt_meta
        if stmt_lines is not None:
            op, table, ts, pos = stmt_meta
            sampler.add(op, table, ts, pos, _clean_statement(stmt_lines), 'statement')
        stmt_lines = stmt_meta = None

    with tempfile.TemporaryFile('w+', errors='replace') as stderr_file:
        process = subprocess.Popen(
            [*base_command, binlog],
            stdout=subprocess.PIPE, stderr=stderr_file,
            text=True, errors='replace', bufsize=1 << 20)
        with process:
            try:
                for line in process.stdout:
                    if sampler is not None:
                        if stmt_lines is not None:
                            if line.startswith('# at '):
                                finish_stmt()
                            else:
                                stmt_lines.append(line)
                                if line.rstrip().endswith(STATEMENT_END):
                                    finish_stmt()
                                continue
                        # A row block ends with the first line that is not a "###" line.
                        if row_lines is not None and not line.startswith('###'):
                            finish_row()
                        # Text of a Rows_query event: "# <sql>" lines until "# at N".
                        if collecting_rows_query:
                            if line.startswith('# ') and not line.startswith('# at '):
                                rows_query.append(line[2:].rstrip('\n'))
                                continue
                            collecting_rows_query = False

                    if line.startswith('###'):
                        if line[4:5] in ROW_FIRST_CHARS:
                            match = ROW_RE.match(line)
                            if match:
                                if row_lines is not None:
                                    finish_row()
                                op = ROW_OPERATIONS[match.group(1)]
                                if op in wanted:
                                    table = _clean_name(match.group(2))
                                    counts[op][table] += 1
                                    if sampler is not None and sampler.wants(op, table):
                                        row_lines = [line]
                                        row_meta = (op, table, event_ts, event_pos,
                                                    '\n'.join(rows_query) if rows_query else None)
                                    continue
                        if row_lines is not None:
                            row_lines.append(line)
                        continue

                    first = line[:1]
                    if first == '#':
                        if sampler is not None:
                            if line.startswith('# at '):
                                last_at = line[5:].strip()
                            elif line[1:2].isdigit():
                                match = EVENT_RE.match(line)
                                if match:
                                    day, clock, event_type = match.groups()
                                    event_ts = f'20{day[0:2]}-{day[2:4]}-{day[4:6]} {clock.zfill(8)}'
                                    event_pos = last_at
                                    if event_type == 'Rows_query':
                                        rows_query = []
                                        collecting_rows_query = True
                                    elif not event_type.startswith(ROW_EVENT_PREFIXES):
                                        rows_query = None
                        continue

                    if first in STATEMENT_FIRST_CHARS:
                        keyword = line.split(None, 1)[0].lower()
                        if keyword in wanted:
                            match = STATEMENT_RES[keyword].match(line)
                            if match:
                                table = _clean_name(match.group(1))
                                counts[keyword][table] += 1
                                if sampler is not None and sampler.wants(keyword, table):
                                    stmt_lines = [line]
                                    stmt_meta = (keyword, table, event_ts, event_pos)
                                    if line.rstrip().endswith(STATEMENT_END):
                                        finish_stmt()

                if sampler is not None:
                    finish_stmt()
                    finish_row()
            finally:
                if sampler is not None:
                    sampler.close()

        if process.returncode != 0:
            stderr_file.seek(0)
            # Drop warnings that are expected when the window extends past the end of a file; Some mysqlbinlog versions
            # exit non-zero for them although all events were printed. Anything else is a real failure.
            lines = [line.strip() for line in stderr_file.read().splitlines() if line.strip()]
            problems = [line for line in lines if not BENIGN_STDERR_RE.match(line)]
            if problems or not lines:
                message = '\n'.join(problems) or f'mysqlbinlog exited with code {process.returncode}'
                raise BinlogAnalysisError(f'{binlog}: {message}')

    return binlog, counts


def analyze_all(cfg: Config, binlogs: Sequence[str],
                samples_dir: Optional[str] = None) -> Dict[str, Counter]:
    """Analyze all logs (in parallel if cfg.jobs > 1) and merge the counters. With
    *samples_dir*, each worker also writes its sampled queries to <samples_dir>/<index>.jsonl."""
    base_command = build_base_command(cfg)
    total = {op: Counter() for op in cfg.operations}
    done = 0

    def samples_path(index: int) -> Optional[str]:
        return os.path.join(samples_dir, f'{index}.jsonl') if samples_dir else None

    def merge(path: str, counts: Dict[str, Counter]) -> None:
        nonlocal done
        done += 1
        for op, counter in counts.items():
            total[op].update(counter)
        Printer.tool(f'  [{done}/{len(binlogs)}] {Path(path).name}')

    workers = min(cfg.jobs, len(binlogs))
    if workers <= 1:
        for index, binlog in enumerate(binlogs):
            merge(*analyze_file(base_command, binlog, cfg.operations, samples_path(index), cfg.query_samples))
        return total

    with ProcessPoolExecutor(max_workers=workers) as pool:
        futures = [pool.submit(analyze_file, base_command, b, cfg.operations,
                               samples_path(i), cfg.query_samples) for i, b in enumerate(binlogs)]
        try:
            for future in as_completed(futures):
                merge(*future.result())
        except BaseException:
            for future in futures:
                future.cancel()
            raise
    return total


# ========  OUTPUT FILES  ========
def _open_private(path: Path):
    """Open a new text file for writing with 0600 permissions (reports contain
    table names and may be sensitive)."""
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    return os.fdopen(fd, 'w', encoding='utf-8', errors='replace')


def write_file_list(binlogs: Sequence[str], path: Path) -> None:
    with _open_private(path) as handle:
        handle.write('\n'.join(binlogs) + '\n')


def write_report(counts: Dict[str, Counter], cfg: Config, binlogs: Sequence[str], path: Path) -> None:
    with _open_private(path) as handle:
        handle.write(
            f'Binary logs report\n'
            f'Period:       {cfg.dt_from:{DATETIME_FORMAT}} - {cfg.dt_to:{DATETIME_FORMAT}}\n'
            f'Log files:    {len(binlogs)}\n'
            f'Generated at: {datetime.now():{DATETIME_FORMAT}}\n\n')
        for op in cfg.operations:
            counter = counts[op]
            title = f'{op.upper()} Operations (total: {sum(counter.values())})'
            handle.write(f'{title}\n{"=" * 30}\n')
            if not counter:
                handle.write('  (none)\n')
            for table, number in sorted(counter.items(), key=lambda item: (-item[1], item[0])):
                handle.write(f'{number:>12}  {table}\n')
            handle.write('\n')


def write_query_files(cfg: Config, binlogs: Sequence[str], samples_dir: str,
                      stamp: str) -> Dict[str, Path]:
    """Merge the per-binlog sample files (in log order) into one SQL file per operation,
    applying the per-table limit across all logs. Streams, so memory stays bounded."""
    paths = {op: cfg.output_dir / f'{stamp}_binary-logs-{op}-queries.sql' for op in cfg.operations}
    limit_text = f'{cfg.query_samples} per table' if cfg.query_samples else 'all queries'
    taken: Counter = Counter()
    handles = {}
    try:
        for op, path in paths.items():
            handle = _open_private(path)
            handles[op] = handle
            handle.write(
                f'-- {op.upper()} queries found in the binary logs\n'
                f'-- Period:  {cfg.dt_from:{DATETIME_FORMAT}} - {cfg.dt_to:{DATETIME_FORMAT}}\n'
                f'-- Samples: {limit_text}\n'
                f'-- Each entry: <event time> | <binlog> @ <position> | <table>\n\n')
        for index in range(len(binlogs)):
            sample_file = Path(samples_dir) / f'{index}.jsonl'
            if not sample_file.exists():
                continue
            with open(sample_file, encoding='utf-8') as source:
                for raw in source:
                    record = json.loads(raw)
                    key = (record['op'], record['table'])
                    if cfg.query_samples and taken[key] >= cfg.query_samples:
                        continue
                    taken[key] += 1
                    handles[record['op']].write(record['entry'] + '\n\n')
    finally:
        for handle in handles.values():
            handle.close()
    return paths


# ========  MAIN LOGIC  ========
def run(cfg: Config) -> int:
    print_config(cfg)

    Printer.tool('Searching for matching binary logs ...')
    binlogs = find_binlogs(cfg)
    if not binlogs:
        Printer.warning('No matching binary log files found! Nothing to do.')
        return 0
    Printer.default(f'Found {len(binlogs)} binary log file(s).')

    stamp = f'{datetime.now():%Y-%m-%d}_{int(time.time())}'
    report_file = cfg.output_dir / f'{stamp}_binary-logs-report.txt'
    list_file = cfg.output_dir / f'{stamp}_binary-logs-list.txt'

    samples_dir = (tempfile.mkdtemp(prefix='.binlog-queries-', dir=cfg.output_dir)
                   if cfg.write_queries else None)
    try:
        Printer.tool(f'Analyzing binary logs with {min(cfg.jobs, len(binlogs))} worker(s) ...')
        started = time.monotonic()
        counts = analyze_all(cfg, binlogs, samples_dir)
        Printer.default(f'Analysis finished in {time.monotonic() - started:.1f}s.')

        Printer.tool('Writing output files ...')
        write_file_list(binlogs, list_file)
        write_report(counts, cfg, binlogs, report_file)
        query_files = write_query_files(cfg, binlogs, samples_dir, stamp) if samples_dir else {}
    finally:
        if samples_dir:
            shutil.rmtree(samples_dir, ignore_errors=True)

    Printer.success('All operations successfully executed!')
    Printer.default(f'Matched binary log files list: {list_file}')
    Printer.default(f'Generated report file:        {report_file}')
    for op, path in query_files.items():
        Printer.default(f'{op.upper() + " queries:":<30}{path}')
    Printer.default('')
    return 0


def main(argv: Optional[Sequence[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.no_color:
        Printer.color_enabled = False
    cfg = build_config(args, parser)
    try:
        return run(cfg)
    except BinlogAnalysisError as exc:
        Printer.error(f'mysqlbinlog failed for {exc}')
        return 1
    except OSError as exc:
        Printer.error(f'{exc.strerror or exc}: {getattr(exc, "filename", "") or ""}'.rstrip(': '))
        return 1
    except KeyboardInterrupt:
        Printer.warning('Interrupted.')
        return 130


if __name__ == '__main__':
    sys.exit(main())
