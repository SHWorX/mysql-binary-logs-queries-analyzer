def load_tkinter() -> bool:
    """Import tkinter on demand. Returns False if it is not installed/usable."""
    global tk, ttk, filedialog, messagebox, scrolledtext
    try:
        import tkinter
        from tkinter import filedialog as _filedialog
        from tkinter import messagebox as _messagebox
        from tkinter import scrolledtext as _scrolledtext
        from tkinter import ttk as _ttk
    except ImportError:
        return False
    tk, ttk, filedialog, messagebox, scrolledtext = tkinter, _ttk, _filedialog, _messagebox, _scrolledtext
    return True


class BinlogGui:
    """Small tkinter front end for the analyzer.

    It does not analyze anything itself: it turns the form into command line options,
    runs this very script with them as a child process and shows the output live. That
    keeps the GUI and the command line mode identical (same validation, same results)
    and lets "Cancel" behave exactly like pressing Ctrl+C in a terminal.
    """

    POLL_MS = 100
    LOG_COLORS = {'error': '#c0392b', 'warning': '#b9770e', 'success': '#1e8449', 'tool': '#1f618d'}

    def __init__(self, args: argparse.Namespace):
        self.root = tk.Tk()
        self.root.title(f'MySQL/MariaDB Binary Log Analyzer v{SCRIPT_VERSION}')
        self.root.minsize(780, 720)

        self.process: Optional[subprocess.Popen] = None
        self.cancelled = False
        self.report_path: Optional[str] = None
        self.messages: queue.Queue = queue.Queue()
        self.inputs: list = []  # widgets that are locked while an analysis is running

        self._create_variables(args)
        self._create_widgets()
        for var in self._variables():
            var.trace_add('write', self._on_change)
        self._on_change()

        self.root.protocol('WM_DELETE_WINDOW', self.on_close)
        self.root.after(self.POLL_MS, self._poll)

    def mainloop(self) -> int:
        self.root.mainloop()
        return 0

    # ----  form  ----
    def _create_variables(self, args: argparse.Namespace) -> None:
        today = datetime.now().replace(hour=0, minute=0, second=0, microsecond=0)
        dt_from = args.dt_from or today
