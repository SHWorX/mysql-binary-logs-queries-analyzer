    @staticmethod
    def _group(parent, row: int, title: str):
        frame = ttk.LabelFrame(parent, text=title, padding=(10, 6))
        frame.grid(row=row, column=0, sticky='ew', pady=(0, 8))
        frame.columnconfigure(1, weight=1)
        return frame

    def _entry(self, parent, row: int, label: str, var, browse=None) -> None:
        ttk.Label(parent, text=label).grid(row=row, column=0, sticky='w', padx=(0, 8), pady=2)
        entry = ttk.Entry(parent, textvariable=var)
        entry.grid(row=row, column=1, sticky='ew', pady=2)
        self.inputs.append(entry)
        if browse:
            button = ttk.Button(parent, text='Browse...', command=browse)
            button.grid(row=row, column=2, padx=(6, 0), pady=2)
            self.inputs.append(button)

    def _browse_dir(self, var):
        def browse():
            chosen = filedialog.askdirectory(
                parent=self.root,
                initialdir=var.get() or None,
                title='Select directory'
            )
            if chosen:
                var.set(chosen)
        return browse

    def _browse_file(self, var):
        def browse():
            chosen = filedialog.askopenfilename(parent=self.root, title='Select file')
            if chosen:
                var.set(chosen)
        return browse

    def _copy_command(self) -> None:
        self.root.clipboard_clear()
        self.root.clipboard_append(self.v_preview.get())

    def _collect_options(self) -> List[str]:
        """Translate the form into command line options for this script.
        Raises ValueError with a user-facing message if the input is invalid."""
        dt_from = self.v_from.get().strip()
        dt_to = self.v_to.get().strip()
        try:
            start = parse_datetime(dt_from) if dt_from else None
            end = parse_datetime(dt_to, end_of_day=True) if dt_to else None
        except argparse.ArgumentTypeError as exc:
            raise ValueError(str(exc)) from None
        if start and end and start > end:
            raise ValueError('The start datetime must not be later than the end datetime.')

        selected = [op for op in ALL_OPERATIONS if self.v_ops[op].get()]
        if not selected:
            raise ValueError('Select at least one SQL operation.')

        try:
            jobs = int(self.v_jobs.get())
        except ValueError:
            raise ValueError('Parallel jobs must be a whole number.') from None
        if jobs < 1:
            raise ValueError('Parallel jobs must be at least 1.')

        log_dir = self.v_log_dir.get().strip()
        log_name = self.v_log_name.get().strip()
        mysqlbinlog = self.v_mysqlbinlog.get().strip()
        if not log_dir:
            raise ValueError('Please enter the directory of the binary logs.')
        if not log_name:
            raise ValueError('Please enter the base name of the binary logs.')
        if not mysqlbinlog:
            raise ValueError('Please enter the mysqlbinlog executable.')

        options = [f'--sql-operations={",".join(selected)}',
                   f'--binary-logs-file-path={log_dir}',
                   f'--binary-logs-file-name={log_name}',
                   f'--jobs={jobs}',
                   f'--mysqlbinlog={mysqlbinlog}']
        if dt_from:
            options.append(f'--dt-from={dt_from}')
        if dt_to:
            options.append(f'--dt-to={dt_to}')
        output = self.v_output.get().strip()
        if output:
            options.append(f'--output-path={output}')
        if self.v_ignore_mtime.get():
            options.append('--ignore-mtime')
        if self.v_no_skip_gtid.get():
            options.append('--no-skip-gtid-strict-mode')
        if self.v_write_queries.get():
            try:
                samples = int(self.v_samples.get())
            except ValueError:
                raise ValueError('Samples per table must be a whole number (0 = all).') from None
            if samples < 0:
                raise ValueError('Samples per table must be 0 (all) or a positive number.')
            options += ['--write-queries', f'--query-samples={samples}']
        return options

    def _on_change(self, *_) -> None:
        try:
            options = self._collect_options()
        except ValueError as exc:
            self.v_preview.set(f'# {exc}')
        else:
            self.v_preview.set(shlex.join([Path(SCRIPT_PATH).name, *options]))
        self._refresh_states()

    def _refresh_states(self) -> None:
        running = self.process is not None
        for widget in self.inputs:
            widget.state(['disabled'] if running else ['!disabled'])
        if not running and not self.v_write_queries.get():
            self.samples_spin.state(['disabled'])
        self.start_button.state(['disabled'] if running else ['!disabled'])
        self.cancel_button.state(['!disabled'] if running else ['disabled'])
        can_show = not running and bool(self.report_path) and Path(self.report_path).is_file()
        self.report_button.state(['!disabled'] if can_show else ['disabled'])

    # ----  running the analysis  ----
    def start(self) -> None:
        if self.process is not None:
            return
        try:
            options = self._collect_options()
        except ValueError as exc:
            messagebox.showerror('Invalid input', str(exc), parent=self.root)
            return

        command = [sys.executable or 'python3', '-u', SCRIPT_PATH, *options, '--no-color']
        self._log('$ ' + shlex.join([Path(SCRIPT_PATH).name, *options]) + '\n', 'tool')
        try:
            self.process = subprocess.Popen(
                command,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                errors='replace',
                bufsize=1,
                start_new_session=True,
                env={**os.environ, 'NO_COLOR': '1', 'PYTHONUNBUFFERED': '1'}
            )
        except OSError as exc:
            self.process = None
            messagebox.showerror('Could not start the analysis', str(exc), parent=self.root)
            return

        self.cancelled = False
        self.report_path = None
        self.progress.configure(maximum=1, value=0)
        self.v_status.set('Running ...')
        self._refresh_states()
        threading.Thread(target=self._reader, args=(self.process,), daemon=True).start()

    def _reader(self, process: subprocess.Popen) -> None:
        """Worker thread: forward the child's output to the GUI thread via a queue."""
        try:
            for line in process.stdout:
                self.messages.put(('line', line))
        finally:
            self.messages.put(('done', process.wait()))

    def _poll(self) -> None:
        for _ in range(500):  # bounded, so a burst of output can't freeze the window
            try:
                kind, payload = self.messages.get_nowait()
            except queue.Empty:
                break
            if kind == 'line':
                self._handle_line(payload)
            else:
                self._finished(payload)
        self.root.after(self.POLL_MS, self._poll)

    @staticmethod
    def _tag_for(text: str) -> Optional[str]:
        if text.startswith('ERROR:') or ': error: ' in text:
            return 'error'
        if text.startswith('WARNING:'):
            return 'warning'
        if 'successfully' in text:
            return 'success'
        return None

    def _handle_line(self, line: str) -> None:
        text = line.rstrip('\n')
        match = REPORT_LINE_RE.match(text)
        if match:
            self.report_path = match.group(1)
        match = PROGRESS_RE.match(text)
        if match:
            done, total = int(match.group(1)), int(match.group(2))
            self.progress.configure(maximum=max(total, 1), value=done)
            self.v_status.set(f'Running ... {done}/{total} binary logs analyzed')
        self._log(text + '\n', self._tag_for(text))

    def _finished(self, returncode: int) -> None:
        self.process = None
        if returncode == 0:
            text, tag = 'Finished successfully.', 'success'
        elif self.cancelled:
            text, tag = 'Cancelled.', 'warning'
        else:
            text, tag = f'Failed (exit code {returncode}).', 'error'
        self.v_status.set(text)
        self._log(f'--- {text}\n', tag)
        self._refresh_states()

    @staticmethod
    def _interrupt(process: subprocess.Popen) -> None:
        """Same as Ctrl+C in a terminal: SIGINT for the whole process group (analyzer,
        its workers and mysqlbinlog), so the analyzer can still clean up after itself."""
        try:
            if hasattr(os, 'killpg'):
                os.killpg(process.pid, signal.SIGINT)
            else:
                process.terminate()
        except OSError:
            pass

    @staticmethod
    def _terminate(process: subprocess.Popen) -> None:
        """Last resort if the process ignored the interrupt."""
        try:
            if hasattr(os, 'killpg'):
                os.killpg(process.pid, signal.SIGTERM)
            else:
                process.kill()
        except OSError:
            pass

    def cancel(self) -> None:
        process = self.process
        if process is None or self.cancelled:
            return
        self.cancelled = True
        self.v_status.set('Cancelling ...')
        self._log('Cancelling ...\n', 'warning')
        self._interrupt(process)
        self.root.after(5000, lambda: self._terminate(process) if self.process is process else None)

    def on_close(self) -> None:
        process = self.process
        if process is not None:
            if not messagebox.askyesno(
                    'Analysis running',
                    'An analysis is still running.\n\nCancel it and quit?',
                    parent=self.root
            ):
                return
            self._interrupt(process)
            try:
                process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                self._terminate(process)
        self.root.destroy()

    def _log(self, text: str, tag: Optional[str] = None) -> None:
        self.log.configure(state='normal')
        self.log.insert('end', text, tag or ())
        self.log.see('end')
        self.log.configure(state='disabled')

    def clear_log(self) -> None:
        self.log.configure(state='normal')
        self.log.delete('1.0', 'end')
        self.log.configure(state='disabled')

    def show_report(self) -> None:
        if not self.report_path:
            return
        try:
            text = Path(self.report_path).read_text(encoding='utf-8', errors='replace')
        except OSError as exc:
            messagebox.showerror('Could not open the report', str(exc), parent=self.root)
            return
        window = tk.Toplevel(self.root)
        window.title(Path(self.report_path).name)
        window.geometry('720x600')
        viewer = scrolledtext.ScrolledText(window, wrap='none', font='TkFixedFont')
        viewer.insert('1.0', text)
        viewer.configure(state='disabled')
        viewer.pack(fill='both', expand=True)


def run_gui(args: argparse.Namespace) -> int:
    """Start the GUI if tkinter is available, otherwise explain what is missing."""
    if not load_tkinter():
        Printer.error(TKINTER_MISSING_MESSAGE)
        return 1
    try:
        gui = BinlogGui(args)
    except tk.TclError as exc:  # Show error if no display is available (headless server, plain SSH session)
        Printer.error(f'The GUI could not be started: {exc}')
        return 1
    return gui.mainloop()


# ========  MAIN LOGIC  ========
def run(cfg: Config) -> int:
    print_config(cfg)

    Printer.tool('Searching for matching binary logs ...')
    binlogs = find_binlogs(cfg)
    if not binlogs:
        Printer.warning('No matching binary log files found! Nothing to do.')
        return 0
    Printer.default(f'Found {len(binlogs)} binary log file(s).')

    stamp = f'{datetime.now():%Y-%m-%d}_{int(time.time())}'
    report_file = cfg.output_dir / f'{stamp}_binary-logs-report.txt'
    list_file = cfg.output_dir / f'{stamp}_binary-logs-list.txt'

    samples_dir = (tempfile.mkdtemp(prefix='.binlog-queries-', dir=cfg.output_dir)
                   if cfg.write_queries else None)
    try:
        Printer.tool(f'Analyzing binary logs with {min(cfg.jobs, len(binlogs))} worker(s) ...')
        started = time.monotonic()
        counts = analyze_all(cfg, binlogs, samples_dir)
        Printer.default(f'Analysis finished in {time.monotonic() - started:.1f}s.')

        Printer.tool('Writing output files ...')
        write_file_list(binlogs, list_file)
        write_report(counts, cfg, binlogs, report_file)
        query_files = write_query_files(cfg, binlogs, samples_dir, stamp) if samples_dir else {}
    finally:
        if samples_dir:
            shutil.rmtree(samples_dir, ignore_errors=True)

    Printer.success('All operations successfully executed!')
    Printer.default(f'Matched binary log files list: {list_file}')
    Printer.default(f'Generated report file:        {report_file}')
    for op, path in query_files.items():
        Printer.default(f'{op.upper() + " queries:":<30}{path}')
    Printer.default('')
    return 0


def main(argv: Optional[Sequence[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.no_color:
        Printer.color_enabled = False
    if args.gui:
        return run_gui(args)
    cfg = build_config(args, parser)
    try:
        return run(cfg)
    except BinlogAnalysisError as exc:
        Printer.error(f'mysqlbinlog failed for {exc}')
        return 1
    except OSError as exc:
        Printer.error(f'{exc.strerror or exc}: {getattr(exc, "filename", "") or ""}'.rstrip(': '))
        return 1
    except KeyboardInterrupt:
        Printer.warning('Interrupted.')
        return 130


if __name__ == '__main__':
    sys.exit(main())