        self.v_from = tk.StringVar(value=f'{dt_from:{DATETIME_FORMAT}}')
        self.v_to = tk.StringVar(value=f'{dt_to:{DATETIME_FORMAT}}')
        self.v_log_dir = tk.StringVar(value=str(args.binary_logs_file_path))
        self.v_log_name = tk.StringVar(value=args.binary_logs_file_name)
        self.v_output = tk.StringVar(value=str(args.output_path or Path.cwd()))
        self.v_ops = {op: tk.BooleanVar(value=op in args.sql_operations) for op in ALL_OPERATIONS}
        self.v_jobs = tk.StringVar(value=str(args.jobs))
        self.v_mysqlbinlog = tk.StringVar(value=args.mysqlbinlog)
        self.v_ignore_mtime = tk.BooleanVar(value=args.ignore_mtime)
        self.v_no_skip_gtid = tk.BooleanVar(value=args.no_skip_gtid_strict_mode)
        self.v_write_queries = tk.BooleanVar(value=args.write_queries)
